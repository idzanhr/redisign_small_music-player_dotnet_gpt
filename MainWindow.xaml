<Window Icon="pack://application:,,,/Assets/musicroom.ico" x:Class="MusicRoom.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Micro Music Room" Width="1200" Height="780" MinWidth="900" MinHeight="620" Background="{StaticResource Canvas}" Foreground="#F5F4F8" FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="NavItem" TargetType="ListBoxItem"><Setter Property="Foreground" Value="#B8B7C1"/><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="#292735"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#25252B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TrackRow" TargetType="ListViewItem"><Setter Property="Foreground" Value="#E8E7EB"/><Setter Property="Padding" Value="12,12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><GridViewRowPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="#302E40"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#25252C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <DataTemplate x:Key="PlaylistNameTemplate"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DataTemplate></Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="94"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="2" Background="{StaticResource Sidebar}" BorderBrush="#202025" BorderThickness="0,0,1,0"><Grid Margin="16,22,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0"><StackPanel Orientation="Horizontal" Margin="8,0,0,30"><Border Width="38" Height="38" CornerRadius="12" Background="#302A4A"><Image Source="pack://application:,,,/Assets/musicroom.png" Width="34" Height="34" Stretch="Uniform"/></Border><StackPanel Margin="11,2,0,0"><TextBlock Text="micro music room" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="YOUR MUSIC, YOUR WAY" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></StackPanel><TextBlock Text="YOUR LIBRARY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="10,0,0,8"/><ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged"><ListBoxItem Content="◫    All songs" Tag="All songs"/><ListBoxItem Content="◉    Recently added" Tag="Recently added"/></ListBox><Grid Margin="9,22,5,9"><TextBlock Text="PLAYLISTS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button Content="＋" Style="{StaticResource IconButton}" FontSize="15" Padding="5" HorizontalAlignment="Right" Click="CreatePlaylist_Click"/></Grid></StackPanel>
   <ListBox x:Name="PlaylistList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" ItemTemplate="{StaticResource PlaylistNameTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PlaylistList_SelectionChanged"/><StackPanel Grid.Row="2"><Button Content="About &amp; License" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,9" Background="Transparent" Margin="0,8,0,2" Click="AboutLicense_Click"/><Border CornerRadius="9" Background="#202025" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="Your music stays yours" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Playlists are saved on this PC. Your audio files stay in their original folders." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="36,26,36,20"><Grid.RowDefinitions><RowDefinition Height="47"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><TextBlock x:Name="Breadcrumb" Text="YOUR LIBRARY  /  ALL SONGS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox x:Name="SearchBox" Width="205" Height="36" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Search tracks and artists" TextChanged="SearchBox_TextChanged"/><Button Content="Add folder" Margin="0,0,8,0" Click="AddFolder_Click"/><Button Content="＋ Add songs" Style="{StaticResource AccentButton}" Click="AddSongs_Click"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="0,24,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="All songs" FontSize="34" FontWeight="Bold"/><TextBlock x:Name="TrackCount" Text="Your music collection" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="RenameButton" Content="Rename" Margin="0,0,7,0" Visibility="Collapsed" Click="RenamePlaylist_Click"/><Button x:Name="DeleteButton" Content="Delete playlist" Margin="0,0,8,0" Visibility="Collapsed" Click="DeletePlaylist_Click"/><Button x:Name="AddToPlaylistButton" Content="Add to playlist  ›" Margin="0,0,8,0" Click="AddSelectedToPlaylist_Click"/><Button Content="▶   Play all" Style="{StaticResource AccentButton}" Click="PlayAll_Click"/></StackPanel></Grid>
   <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="2.6*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="#" Foreground="{StaticResource Muted}" Margin="15,8" FontSize="11"/><TextBlock Grid.Column="1" Text="TITLE" Foreground="{StaticResource Muted}" Margin="8" FontSize="10"/><TextBlock Grid.Column="2" Text="ALBUM" Foreground="{StaticResource Muted}" Margin="8" FontSize="10"/><TextBlock Grid.Column="3" Text="FOLDER" Foreground="{StaticResource Muted}" Margin="8" FontSize="10"/><TextBlock Grid.Column="4" Text="TIME" Foreground="{StaticResource Muted}" Margin="0,8" FontSize="10"/></Grid>
   <ListView x:Name="TrackList" Grid.Row="3" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource TrackRow}" SelectionMode="Extended" MouseDoubleClick="TrackList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.View><GridView AllowsColumnReorder="False"><GridViewColumn Width="48"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="♫" Foreground="#A99BFF" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Width="330" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Width="180" DisplayMemberBinding="{Binding Album}"/><GridViewColumn Width="150" DisplayMemberBinding="{Binding Folder}"/><GridViewColumn Width="55" DisplayMemberBinding="{Binding DurationLabel}"/></GridView></ListView.View><ListView.ContextMenu><ContextMenu><MenuItem Header="Play" Click="ContextPlay_Click"/><MenuItem Header="Add to playlist…" Click="ContextAdd_Click"/></ContextMenu></ListView.ContextMenu></ListView>
   <Border x:Name="EmptyState" Grid.Row="3" Visibility="Visible"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390"><Border Width="74" Height="74" CornerRadius="23" Background="#282438" HorizontalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="♫" FontSize="36" Foreground="#B9ACFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your music starts here" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Add an artist folder to build a playlist automatically, or add songs to make a mix." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center" Margin="10,9,10,20"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Add music folder" Style="{StaticResource AccentButton}" Click="AddFolder_Click"/><Button Content="Browse songs" Margin="8,0,0,0" Click="AddSongs_Click"/></StackPanel></StackPanel></Border>
  </Grid>
  <Border Grid.Column="1" Grid.Row="1" Background="#19191E" BorderBrush="#2A2A30" BorderThickness="0,1,0,0"><Grid Margin="20,8"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="53" Height="53" CornerRadius="10" Background="#302A4A"><TextBlock Text="♫" FontSize="24" Foreground="#C2B6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock x:Name="NowTitle" Text="Nothing playing" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="NowArtist" Text="Pick a song to start listening" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="540"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="ShuffleButton" Content="⤨" Style="{StaticResource IconButton}" Foreground="{StaticResource Muted}" Click="Shuffle_Click"/><Button Content="⏮" Style="{StaticResource IconButton}" Click="Previous_Click"/><Button Content="▶" Width="38" Height="38" Padding="0" FontSize="15" Background="#F1EFF8" Foreground="#151519" Click="TogglePlay_Click"/><Button Content="⏭" Style="{StaticResource IconButton}" Click="Next_Click"/><Button x:Name="RepeatButton" Content="↻" Style="{StaticResource IconButton}" Foreground="{StaticResource Muted}" Click="Repeat_Click"/></StackPanel><Grid Margin="4,2,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedLabel" Text="0:00" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="ProgressSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="ProgressSlider_ValueChanged" PreviewMouseLeftButtonDown="ProgressSlider_DragStart" PreviewMouseLeftButtonUp="ProgressSlider_DragEnd"/><TextBlock x:Name="DurationLabel" Grid.Column="2" Text="0:00" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="◖" Foreground="{StaticResource Muted}" FontSize="17" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Width="105" Minimum="0" Maximum="1" Value="0.7" Margin="8,0,0,0"/></StackPanel></Grid></Border>
 </Grid>
</Window>

