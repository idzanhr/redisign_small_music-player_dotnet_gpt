<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MicroMusicRoom</AssemblyName>
    <RootNamespace>MusicRoom</RootNamespace>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3</AssemblyVersion>
    <FileVersion>1.0.3</FileVersion>
    <ApplicationIcon>Assets\musicroom.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Remove="Assets\musicroom.ico;Assets\musicroom.png" />
    <Resource Include="Assets\musicroom.ico;Assets\musicroom.png" />
  </ItemGroup>
</Project>

