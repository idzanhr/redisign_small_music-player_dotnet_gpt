<Application x:Class="MusicRoom.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#111114"/><SolidColorBrush x:Key="Sidebar" Color="#17171B"/><SolidColorBrush x:Key="Panel" Color="#1C1C22"/><SolidColorBrush x:Key="Line" Color="#2B2B32"/><SolidColorBrush x:Key="Muted" Color="#92929D"/><SolidColorBrush x:Key="Accent" Color="#9B8AFB"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#F5F4F8"/><Setter Property="Background" Value="#25252C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34343D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7967E8"/></Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="18"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F5F4F8"/><Setter Property="Background" Value="#25252C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="13"/></Style>
  </Application.Resources>
</Application>

